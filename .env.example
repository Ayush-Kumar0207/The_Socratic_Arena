# Docker Compose / backend configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key
GEMINI_API_KEY=replace-with-gemini-api-key
GOOGLE_API_KEY=replace-with-google-api-key
ENABLE_ADVANCED_AI=false
CLIENT_ORIGIN=http://localhost:8080
PORT=5000

# Public-beta launch controls. Daily allowances reset at 00:00 UTC and use
# Redis when configured, so they remain shared across backend instances.
AI_PRACTICE_TURNS_PER_USER_DAILY=20
AI_PRACTICE_SESSIONS_PER_USER_DAILY=5
AI_PRACTICE_TURNS_GLOBAL_DAILY=4000
AI_PRACTICE_SESSIONS_GLOBAL_DAILY=1000
EVIDENCE_ARENA_SESSIONS_PER_USER_DAILY=3
EVIDENCE_ARENA_SESSIONS_GLOBAL_DAILY=75
AI_SUMMARIES_PER_USER_DAILY=10
AI_SUMMARIES_GLOBAL_DAILY=1000
AI_OBJECTIONS_PER_USER_DAILY=10
AI_OBJECTIONS_GLOBAL_DAILY=1000
TTS_REQUESTS_PER_USER_DAILY=40
TTS_REQUESTS_GLOBAL_DAILY=1000
API_REQUESTS_PER_IP_PER_MINUTE=300

# Render sits behind one trusted proxy. Set 0 for a directly exposed server.
TRUST_PROXY_HOPS=1

# Protect administrative and observability endpoints in shared environments.
ADMIN_SECRET=replace-with-a-long-random-secret
CREDENTIAL_SIGNING_SECRET=replace-with-an-independent-32-byte-random-secret
METRICS_TOKEN=replace-with-a-long-random-token
ALERT_WEBHOOK_SECRET=replace-with-a-long-random-secret
ALERT_WEBHOOK_URL=
ALERT_LOG_PATH=tmp/alerts.log

# Optional local/free speech-to-text service
FREE_STT_ENABLED=false
FREE_STT_URL=
FREE_STT_TIMEOUT_MS=20000
FREE_STT_STATUS_TIMEOUT_MS=2500
FREE_STT_MAX_AUDIO_BYTES=8388608
MAX_PDF_UPLOAD_BYTES=10485760

# Evidence Arena retrieval. "memory" works without a database migration;
# "supabase" persists extracted chunks/embeddings and falls back safely.
RAG_VECTOR_BACKEND=memory
RETRIEVER_TOP_K=4

# Server-side Amazon Polly text-to-speech (never expose as VITE_ variables).
TTS_ENABLED=false
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=standard
POLLY_MAX_CHARACTERS=2800

# Redis enables shared Socket.IO rooms, matchmaking, presence, reconnect state,
# and timer leases across multiple backend instances. Leave blank for local
# single-instance development.
REDIS_URL=redis://localhost:6379
INSTANCE_ID=

# Measured three-judge calibration benchmark
JUDGE_BENCHMARK_MODEL=gemini-2.5-flash

# Frontend build-time public values (never put service-role keys here)
VITE_BACKEND_URL=http://localhost:5000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key

# Commercial platform — OFF by default so beta deployments are unchanged.
# Enable backend and frontend only after migration 008, sandbox checkout, and
# signed webhook tests have all passed in the target environment.
COMMERCIAL_MODE_ENABLED=false
VITE_COMMERCIAL_MODE_ENABLED=false

# Global billing: Paddle Merchant of Record. Use sandbox credentials until the
# commercial-release checklist is approved.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PLUS_MONTHLY=
PADDLE_PRICE_PLUS_ANNUAL=
PADDLE_PRICE_PREMIUM_MONTHLY=
PADDLE_PRICE_PREMIUM_ANNUAL=

# India billing: Razorpay subscriptions in INR (UPI Autopay/cards/eMandate).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PLUS_MONTHLY=
RAZORPAY_PLAN_PLUS_ANNUAL=
RAZORPAY_PLAN_PREMIUM_MONTHLY=
RAZORPAY_PLAN_PREMIUM_ANNUAL=
