# Docker Compose / backend configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key
GEMINI_API_KEY=replace-with-gemini-api-key
GOOGLE_API_KEY=replace-with-google-api-key
ENABLE_ADVANCED_AI=false
CLIENT_ORIGIN=http://localhost:8080
PORT=5000

# Protect administrative and observability endpoints in shared environments.
ADMIN_SECRET=replace-with-a-long-random-secret
METRICS_TOKEN=replace-with-a-long-random-token
ALERT_WEBHOOK_SECRET=replace-with-a-long-random-secret
ALERT_WEBHOOK_URL=
ALERT_LOG_PATH=tmp/alerts.log

# Optional local/free speech-to-text service
FREE_STT_ENABLED=false
FREE_STT_URL=
FREE_STT_TIMEOUT_MS=20000
FREE_STT_STATUS_TIMEOUT_MS=2500
FREE_STT_MAX_AUDIO_BYTES=8388608

# Frontend build-time public values (never put service-role keys here)
VITE_BACKEND_URL=http://localhost:5000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key
