{
  "name": "the-socratic-arena-backend",
  "version": "1.0.0",
  "description": "Backend API and real-time debate engine for The Socratic Arena",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.mjs",
    "smoke:hosted": "node scripts/hostedSmoke.mjs",
    "benchmark:judge": "node scripts/runJudgeBenchmark.mjs",
    "benchmark:judge:dry": "node scripts/runJudgeBenchmark.mjs --dry-run"
  },
  "keywords": [
    "express",
    "socket.io",
    "langchain",
    "mongodb",
    "rag",
    "ai-debate"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1112.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^0.3.19",
    "@langchain/google-genai": "^0.1.7",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.99.2",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "langchain": "^0.3.3",
    "mongoose": "^8.7.1",
    "multer": "2.2.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "pg": "^8.20.0"
  },
  "overrides": {
    "langsmith": "0.8.8",
    "uuid": "11.1.1"
  }
}
